# ============================================================================
# Environment Variables - Web Portal OSIS SMAN 2 Pangkep (Vercel & Lokal)
# Salin file ini menjadi .env.local untuk pengembangan lokal
# ============================================================================

# 1. Konfigurasi Utama Supabase (WAJIB)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-public-key"

# 2. Konfigurasi Domain Publik & SEO / Open Graph (WAJIB untuk Sitemap & OG Image)
NEXT_PUBLIC_SITE_URL="https://osis-sman2pangkep.sch.id"

# 3. Konfigurasi Anti-Spam Cloudflare Turnstile / reCAPTCHA (OPSIONAL / PRODUKSI)
NEXT_PUBLIC_TURNSTILE_SITE_KEY="your-cloudflare-turnstile-site-key"
TURNSTILE_SECRET_KEY="your-cloudflare-turnstile-secret-key"

# 4. Supabase Service Role Key (OPSIONAL - Hanya untuk operasi admin server-side)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"
